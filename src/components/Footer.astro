---
import { legalNav, nav, site } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <span class="brand-lockup">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">{site.name}</span>
        </span>
      </a>
    </div>
    <div>
      <p class="footer-label">Explore</p>
      <ul class="footer-links">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="footer-label">Legal</p>
      <ul class="footer-links">
        {
          legalNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="footer-label">Follow</p>
      <p class="footer-line">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        <a href={site.instagramHref} target="_blank" rel="noopener noreferrer">{site.instagram}</a>
      </p>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
