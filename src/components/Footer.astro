---
import { nav, site } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <span class="brand-lockup">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">{site.name}</span>
        </span>
      </a>
      <p class="footer-label">Visit</p>
      <p class="footer-line">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{site.location}</span>
      </p>
      <p class="footer-line">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
      </p>
    </div>
    <div>
      <p class="footer-label">Explore</p>
      <ul class="footer-links">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="footer-label">Follow</p>
      <p class="footer-line">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        <a href={site.instagramHref} target="_blank" rel="noopener noreferrer">{site.instagram}</a>
      </p>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <nav class="legal-links" aria-label="Legal">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/accessibility">Accessibility</a>
    </nav>
    <p>Sanger, California</p>
  </div>
</footer>
