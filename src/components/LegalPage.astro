---
import Layout from "../layouts/Layout.astro";
import PageIntro from "./PageIntro.astro";
import { heroFor } from "../data/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
const hero = heroFor(Astro.url.pathname);
---

<Layout title={title} description={hero.description}>
  <PageIntro title={hero.title} titleEm={hero.titleEm} lede={hero.lede} />
  <section class="section">
    <div class="wrap legal-copy">
      <slot />
    </div>
  </section>
</Layout>
