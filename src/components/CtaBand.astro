---
import { closingFor, site } from "../data/site";

const line = closingFor(Astro.url.pathname);
---

<section class="close">
  <div class="close-inner">
    <h2>
      {line.title}
      {line.titleEm && (
        <>
          {" "}
          <em>{line.titleEm}</em>
        </>
      )}
    </h2>
    <p>{line.text}</p>
    <div class="cta-row">
      <a class="pill" href={line.buttonHref ?? site.bookHref}>{line.buttonLabel}</a>
    </div>
  </div>
</section>
