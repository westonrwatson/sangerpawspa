---
import { site, visitHours } from "../data/site";

const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&z=15&output=embed`;
---

<section class="section visit-section" aria-labelledby="visit-heading">
  <div class="wrap">
    <div class="section-head center">
      <h2 id="visit-heading">Hours & location</h2>
    </div>
    <div class="visit-layout">
      <div class="visit-copy">
        <div class="visit-block">
          <h3>Address</h3>
          <p class="footer-line visit-line">
            <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{site.location}</span>
          </p>
        </div>
        <div class="visit-block">
          <h3>Hours</h3>
          <ul class="hours-list">
            {
              visitHours.map((row) => (
                <li>
                  <span>{row.days}</span>
                  <span>{row.time}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="visit-block">
          <h3>Phone</h3>
          <p class="footer-line visit-line">
            <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
          </p>
        </div>
      </div>
      <div class="visit-map">
        <iframe
          title="Map showing The Paw Spa in Sanger, California"
          src={mapEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>
