---
import Layout from "../layouts/Layout.astro";
import Frame from "../components/Frame.astro";
import { faqs, heroFor, homeSectionSubtitles, site } from "../data/site";

const hero = heroFor("/");

const homeShots = [
  {
    label: "A goldendoodle after a groom at The Paw Spa",
    src: "/images/groom-goldendoodle.jpg",
  },
  {
    label: "A Yorkshire terrier after a groom at The Paw Spa",
    src: "/images/groom-yorkie-flower.jpg",
  },
  {
    label: "A spaniel after a groom at The Paw Spa",
    src: "/images/groom-spaniel.jpg",
  },
  {
    label: "A bath at The Paw Spa",
    src: "/images/groom-bath.jpg",
  },
  {
    label: "A poodle after a groom at The Paw Spa",
    src: "/images/groom-poodle.jpg",
  },
  {
    label: "A Pomeranian after a groom at The Paw Spa",
    src: "/images/groom-pom.jpg",
  },
];

const groomSteps = [
  {
    n: "01",
    title: "Send a booking request.",
    text: "Share your dog’s size, coat type, and how you want them to look. We’ll confirm service and timing with you.",
  },
  {
    n: "02",
    title: "Bath, then the groom.",
    text: "Every visit starts with a wash and dry. After that comes the cut, tidy, or any add-ons you booked.",
  },
  {
    n: "03",
    title: "Pick-up when they’re ready.",
    text: "We’ll let you know when they’re finished: clean, dry, and comfortable.",
  },
];

const heroPhoto = {
  src: "/images/groom-bath.jpg",
  position: "center 32%",
};

const team = ["Groomer", "Groomer", "Groomer", "Groomer"];
---

<Layout
  title="Home"
  description={hero.description}
>
  <section class="hero">
    <div class="hero-panel" style={`--hero-position: ${heroPhoto.position};`}>
      <img
        class="hero-panel-photo"
        src={heroPhoto.src}
        alt=""
        aria-hidden="true"
        width="1600"
        height="900"
        decoding="async"
        fetchpriority="high"
      />
      <h1>
        {hero.title}
        {hero.titleEm && (
          <>
            {" "}
            <em>{hero.titleEm}</em>
          </>
        )}
      </h1>
      <p>{hero.lede}</p>
      <a class="pill" href={hero.buttonHref ?? site.bookHref}>{hero.buttonLabel ?? site.bookLabel}</a>
    </div>
  </section>

  <section class="section how expect" aria-labelledby="how-heading">
    <div class="wrap how-inner">
      <header class="how-path-head">
        <h2 id="how-heading">How it works</h2>
      </header>
      <ol class="how-path">
        {
          groomSteps.map((step) => (
            <li class="how-path-stop">
              <span class="how-path-index" aria-hidden="true">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="how-foot">
        <a class="text-link" href="/pricing">See services & pricing</a>
      </p>
    </div>
  </section>

  <section class="section gallery-band">
    <div class="wrap">
      <div class="section-head center">
        <h2>From the grooming room</h2>
        <p class="section-subtitle">{homeSectionSubtitles.gallery}</p>
      </div>
      <div class="home-gallery">
        {
          homeShots.map((shot) => (
            <a href="/gallery">
              <Frame ratio="square" label={shot.label} src={shot.src} />
            </a>
          ))
        }
      </div>
      <div class="cta-row">
        <a class="text-link" href="/gallery">View full gallery</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap feature feature-photo-end">
      <Frame ratio="landscape" label="The Paw Spa salon in Sanger" src="/images/storefront.jpg" />
      <div class="stack">
        <h2>The salon</h2>
        <p>
          The Paw Spa is a local grooming room in Sanger built for full grooms: time to dry the coat, a clean workspace, and careful scissoring instead of a rushed bath-only visit.
        </p>
        <p>
          Book every few weeks or once in a while. Before we start, we look at the coat with you and agree on length, shape, and price.
        </p>
      </div>
    </div>
  </section>

  <section class="section team-section">
    <div class="wrap">
      <div class="section-head center">
        <h2>Our team</h2>
        <p class="section-subtitle">{homeSectionSubtitles.team}</p>
      </div>
      <div class="team-grid">
        {
          team.map((name) => (
            <figure>
              <Frame ratio="portrait" label={`${name} at The Paw Spa`} />
              <figcaption>{name}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <h2>Frequently Asked Questions</h2>
        <p class="section-subtitle">{homeSectionSubtitles.faq}</p>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary><span>{item.q}</span></summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
