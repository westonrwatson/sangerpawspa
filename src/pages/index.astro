---
import Layout from "../layouts/Layout.astro";
import Frame from "../components/Frame.astro";
import { faqs, site } from "../data/site";

const homeShots = [
  {
    label: "A goldendoodle after a groom at The Paw Spa",
    src: "/images/groom-goldendoodle.jpg",
    position: "center 30%",
  },
  {
    label: "A Yorkshire terrier after a groom at The Paw Spa",
    src: "/images/groom-yorkie-flower.jpg",
    position: "center 42%",
  },
  {
    label: "A spaniel after a groom at The Paw Spa",
    src: "/images/groom-spaniel.jpg",
    position: "center 28%",
  },
  {
    label: "A bath at The Paw Spa",
    src: "/images/groom-bath.jpg",
    position: "center 32%",
  },
  {
    label: "A poodle after a groom at The Paw Spa",
    src: "/images/groom-poodle.jpg",
    position: "center 24%",
  },
  {
    label: "A Pomeranian after a groom at The Paw Spa",
    src: "/images/groom-pom.jpg",
    position: "center 32%",
  },
];

const groomSteps = [
  {
    n: "01",
    title: "Tell us the plan.",
    text: "Coat, size, and the look you want that day.",
  },
  {
    n: "02",
    title: "Bath, then the groom.",
    text: "A wash and a dry, then the haircut, tidy, or spa add-on.",
  },
  {
    n: "03",
    title: "They head home.",
    text: "Clean, comfortable, and ready to be admired.",
  },
];
---

<Layout
  title="Home"
  description="The Paw Spa is a locally owned pet grooming salon in Sanger, California. Baths, full grooms, spa treatments, and creative color."
>
  <section class="hero">
    <Frame ratio="wide" label="The Paw Spa storefront in Sanger" src="/images/storefront.jpg" position="center 42%" />
    <div class="wrap hero-copy">
      <h1>More than a basic bath,<br /><em>it’s a spa experience.</em></h1>
      <p class="lede">
        A locally owned salon in Sanger, for a groom that feels special.
      </p>
      <div class="cta-row">
        <a class="pill" href={site.bookHref}>Book a visit</a>
      </div>
      <hr class="hero-rule" />
    </div>
  </section>

  <section class="section steps expect">
    <div class="wrap">
      <div class="section-head center">
        <h2>How It Works</h2>
      </div>
      <div class="step-grid">
        {
          groomSteps.map((step) => (
            <article>
              <span>{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
      <p class="steps-link">
        <a class="text-link" href="/pricing">See services & pricing</a>
      </p>
    </div>
  </section>

  <section class="section gallery-band">
    <div class="wrap">
      <div class="home-gallery">
        {
          homeShots.map((shot) => (
            <a href="/gallery">
              <Frame ratio="landscape" label={shot.label} src={shot.src} position={shot.position} />
            </a>
          ))
        }
      </div>
      <div class="cta-row">
        <a class="text-link" href="/gallery">See the gallery</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary><span>{item.q}</span></summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
