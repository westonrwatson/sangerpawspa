---
import Layout from "../layouts/Layout.astro";
import Frame from "../components/Frame.astro";

const team = ["Name", "Name", "Name", "Name"];
---

<Layout
  title="About"
  description="The Paw Spa is a locally owned pet grooming salon in Sanger, California."
>
  <section class="wrap">
    <div class="feature feature-photo-end">
      <Frame ratio="landscape" label="The Paw Spa salon in Sanger" src="/images/storefront.jpg" />
      <div class="stack">
        <h2>About The Spa</h2>
        <p>
          The Paw Spa was created with one goal: to give pets a grooming experience that feels a little more special.
        </p>
        <p>
          We care about quiet work, a welcoming room, and helping every pup look and feel their best. From a routine groom to a spa treatment, every pet is treated like family.
        </p>
      </div>
    </div>
  </section>

  <section class="section owner">
    <div class="wrap owner-grid">
      <Frame ratio="portrait" label="Owner" />
      <div class="stack">
        <h2>The Owner</h2>
        <p>
          The Paw Spa is locally owned in Sanger. It was opened so a groom could feel quieter, and a little more special, than a basic bath.
        </p>
        <p>
          The owner still sets that standard for the salon: a calm room, careful work, and a finish pets can leave with.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <h2>Our Team</h2>
      </div>
      <div class="team-grid">
        {
          team.map((name) => (
            <figure>
              <Frame ratio="portrait" label="Photo" />
              <figcaption>{name}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
